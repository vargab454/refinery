(:Resource)
(:Compute => Resource)
(:Storage => Resource)
(:Network => Resource)
(:Server => Compute)
(:Container => Compute)
(:Database => Storage)
(:Cache => Storage)
(:MessageQueue => Storage)
(:LoadBalancer => Network)
(:Subnet => Network)
(:Service)
(:Frontend => Service)
(:Backend => Service)
(:Worker => Service)
(:Region)
(:AvailabilityZone)

(:Service)-[:HOSTED_ON]->(:Compute)
(:Compute)-[:LOCATED_IN]->(:Subnet)
(:Subnet)-[:PART_OF]->(:AvailabilityZone)
(:AvailabilityZone)-[:BELONGS_TO]->(:Region)
(:Frontend)-[:ROUTED_BY]->(:LoadBalancer)
(:LoadBalancer)-[:FORWARDS_TO]->(:Backend)
(:Backend)-[:PUBLISHES_TO]->(:MessageQueue)
(:Worker)-[:CONSUMES_FROM]->(:MessageQueue)
(:Service)-[:READS_FROM]->(:Storage)
(:Service)-[:WRITES_TO]->(:Storage)

CONSTRAINT (b: Backend)-[PUBLISHES_TO]->(mq: MessageQueue)<-[CONSUMES_FROM]-(w: Worker)-[WRITES_TO]->(db: Database)
IMPLIES (b: Backend)-[HOSTED_ON]->(c1: Compute)-[LOCATED_IN]->(s1: Subnet)-[PART_OF]->(az1: AvailabilityZone)-[BELONGS_TO]->(r: Region)<-[BELONGS_TO]-(az2: AvailabilityZone)<-[PART_OF]-(s2: Subnet)<-[LOCATED_IN]-(c2: Compute)<-[HOSTED_ON]-(db: Database)

CONSTRAINT (lb: LoadBalancer)-[FORWARDS_TO]->(b: Backend)
IMPLIES (b: Backend)-[READS_FROM]->(c: Cache)-[HOSTED_ON]->(comp1: Compute)-[LOCATED_IN]->(sub1: Subnet)-[PART_OF]->(az: AvailabilityZone)<-[PART_OF]-(sub2: Subnet)<-[LOCATED_IN]-(comp2: Compute)<-[HOSTED_ON]-(lb: LoadBalancer)
